    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.85.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.8",
